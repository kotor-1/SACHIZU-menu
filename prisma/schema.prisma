// ============================================================================
// SACHIZU メニュー作成 — Prisma Schema (Phase 1)
//
// 設計の中核となる 3 つの責務分離:
//
//   1. Exercise      … 「種目そのもの」= 再利用される知識。
//                       誰が・いつ・どれだけやるかとは無関係。
//   2. MenuItem      … 「このメニューでの処方」= 計画。
//                       同じ Aスキップでも メニューA では 2set×30m、
//                       メニューB では 3set×20m になりうる。
//   3. SessionItem   … 「実際にやった事実」= 記録。
//                       生成時点で名前・処方をスナップショットするため、
//                       後から Exercise / MenuTemplate を編集しても
//                       過去のセッション記録は一切変化しない。
//
// SQLite 制約への対応:
//   - Prisma の SQLite provider は enum / スカラー配列を持てないため、
//     enum 相当は String + src/domain/**/constants.ts の const union で表現し、
//     配列相当は中間テーブルで正規化している。
//     PostgreSQL へ移行する際は String → enum に置換するだけで済む形にしてある。
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// カタログ層: 種目 / ドリル
// ----------------------------------------------------------------------------

/// 種目・ドリル 1 件。練習メニューから何度でも再利用される「知識」。
model Exercise {
  id      String @id @default(cuid())
  /// 将来のマルチコーチ対応に備えた所有者。Phase 1 では既定値のみ使用。
  ownerId String @default("default-coach")

  name          String
  /// 五十音での並び替え・検索用。任意。
  nameKana      String?
  /// 種目の説明・実施手順。
  description   String?
  /// コーチングポイント（選手に伝える意識点）。
  coachingPoint String?
  /// ありがちな失敗・注意点。
  commonMistake String?

  /// ExerciseCategory (src/domain/exercise/constants.ts)
  category   String
  /// MetricType — この種目の負荷を何で測るか。入力 UI の出し分けに使う。
  metricType String @default("REPS")
  /// 1(易) 〜 5(難)
  difficulty Int    @default(3)
  /// EnergySystem — 主として使うエネルギー供給系。処方ロジック（レスト・総量上限）の判定軸。
  /// 未設定でも category / targets から推定できるため nullable。
  energySystem String?

  // --- 推奨負荷（あくまで既定値。メニューに追加する際の初期値として使われる）---
  defaultSets            Int?
  defaultReps            Int?
  defaultDistanceMeters  Float?
  defaultDurationSeconds Int?
  defaultRestSeconds     Int?

  /// 外部動画 URL（YouTube 等）。アップロード動画は VideoAsset を使う。
  videoUrl String?

  /// ContentSource — MANUAL / AI_DRAFT / IMPORTED。AI 由来かを区別する。
  source String @default("MANUAL")
  /// ReviewStatus — DRAFT / REVIEWED / ARCHIVED。
  /// AI 下書きから作られた種目は DRAFT で入り、コーチ確認後 REVIEWED になる。
  status String @default("REVIEWED")

  /// 頻繁に使う種目をすぐ見つけるための目印。一覧・詳細から ON/OFF する。
  isFavorite Boolean @default(false)

  targets           ExerciseTarget[]
  /// この種目の練習目的（加速・接地・姿勢…）。対象能力（targets）とは別軸。
  purposes          ExercisePurpose[]
  /// この種目が主に対象とする競技種目（短距離・ハードル…）。
  events            ExerciseEvent[]
  tags              ExerciseTag[]
  menuItems         MenuItem[]
  sessionItems      SessionItem[]
  videoAssets       VideoAsset[]
  /// この種目として確定した AI 下書き（あれば）
  appliedFromDrafts ExerciseDraft[]
  videoGuidanceRevisions ExerciseVideoGuidanceRevision[]
  videoGuidanceHeads     ExerciseVideoGuidanceHead[]
  videoGuidanceAuditEvents VideoGuidanceAuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, category])
  @@index([ownerId, status])
  @@index([ownerId, isFavorite])
  @@index([name])
}

/// 種目が狙う能力（スピード / 持久力 / 技術 …）。複数持てるので中間テーブル。
model ExerciseTarget {
  exerciseId String
  /// TrainingTarget (src/domain/exercise/constants.ts)
  target     String

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([exerciseId, target])
  @@index([target])
}

/// 種目の練習目的（加速・接地・姿勢…）。ExerciseTarget と同型の中間テーブルで
/// 1 Exercise : N Purpose を表現する。将来 Purpose の種類が増えても
/// テーブル構造は変わらない（src/domain/exercise/constants.ts に値を足すだけ）。
model ExercisePurpose {
  exerciseId String
  /// ExercisePurposeValue (src/domain/exercise/constants.ts)
  purpose    String

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([exerciseId, purpose])
  @@index([purpose])
}

/// 種目が対象とする競技種目（短距離・ハードル…）。ExerciseTarget と同型。
/// 1 Exercise : N Event。
model ExerciseEvent {
  exerciseId String
  /// TrackFieldEvent (src/domain/exercise/constants.ts)
  event      String

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([exerciseId, event])
  @@index([event])
}

/// タグ。kind によって「自由タグ / 使用器具 / 部位」を 1 つの仕組みで扱う。
model Tag {
  id   String @id @default(cuid())
  name String
  /// TagKind — GENERAL / EQUIPMENT / BODY_PART
  kind String @default("GENERAL")

  exercises ExerciseTag[]
  menus     MenuTag[]

  createdAt DateTime @default(now())

  @@unique([kind, name])
  @@index([kind])
}

model ExerciseTag {
  exerciseId String
  tagId      String

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([exerciseId, tagId])
  @@index([tagId])
}

// ----------------------------------------------------------------------------
// 計画層: 練習メニュー（テンプレート）
// ----------------------------------------------------------------------------

/// 練習メニューの雛形。ブロック > アイテム の 2 階層で構成する。
model MenuTemplate {
  id      String @id @default(cuid())
  ownerId String @default("default-coach")

  name             String
  description      String?
  /// このメニューの狙い。
  purpose          String?
  /// TrainingPhase — 期分け（準備期 / 試合期 など）。
  phase            String?
  /// 想定所要時間（分）。null の場合は blocks から概算する。
  estimatedMinutes Int?

  /// [Running v2] RunningMenuContext（Zod・schemaVersion 付き）。健康情報は保存しない。
  runningContextJson String?

  /// ReviewStatus — DRAFT / REVIEWED / ARCHIVED
  status String @default("DRAFT")

  blocks   MenuBlock[]
  tags     MenuTag[]
  /// このテンプレートから作られたセッション（参照のみ。実体は各 Session が保持）
  sessions TrainingSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([name])
}

model MenuTag {
  menuTemplateId String
  tagId          String

  menuTemplate MenuTemplate @relation(fields: [menuTemplateId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([menuTemplateId, tagId])
  @@index([tagId])
}

/// メニュー内の構成単位（ウォームアップ / ドリル / 主運動 / 補強 / クールダウン）。
model MenuBlock {
  id             String @id @default(cuid())
  menuTemplateId String

  name      String
  note      String?
  sortOrder Int     @default(0)

  menuTemplate MenuTemplate @relation(fields: [menuTemplateId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@index([menuTemplateId, sortOrder])
}

/// メニュー内の 1 種目 = 「この種目を、このメニューでは どう やるか」という処方。
/// Exercise（何をやるか）と MenuItem（どうやるか）を分離しているのが要点。
model MenuItem {
  id          String  @id @default(cuid())
  menuBlockId String
  /// 参照する種目。種目が削除された場合に備え名前をスナップショットしておく。
  exerciseId  String?

  /// 参照切れ・自由記述項目（「3km ジョグ」など種目化しないもの）用の表示名。
  displayName String?

  sortOrder Int @default(0)

  // --- 処方（このメニュー固有の負荷設定）---
  sets             Int?
  reps             Int?
  distanceMeters   Float?
  durationSeconds  Int?
  restSeconds      Int?
  /// 強度（%）。スプリントの 90% 走など。
  intensityPercent Int?
  /// 重量（kg）。ウエイト種目用。
  loadKg           Float?
  /// この項目だけの指示・補足。
  note             String?

  // --- Running Prescription Engine v2（prescriptionKind=RUNNING_V2 の項目だけが使う）---
  /// LEGACY | RUNNING_V2
  prescriptionKind       String  @default("LEGACY")
  runningMethod          String?
  sessionTemplateId      String?
  /// FULL | INCOMPLETE（LONG のみ）
  recoveryStructure      String?
  buildUpDistanceMeters  Float?
  flyZoneDistanceMeters  Float?
  setRestSeconds         Int?
  intraRepRestSeconds    Int?
  intensityReferenceKind String?
  prescriptionConfidence String?
  ruleSetVersion         String?
  ruleSetContentHash     String?
  /// RunningPrescription（≤32KB）
  prescriptionJson       String?
  /// Provenance（≤16KB）
  provenanceJson         String?
  /// 生成時点の日本語テキスト（≤4000字）
  rationale              String?

  menuBlock MenuBlock @relation(fields: [menuBlockId], references: [id], onDelete: Cascade)
  exercise  Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([menuBlockId, sortOrder])
  @@index([exerciseId])
  @@index([prescriptionKind, runningMethod])
}

// ----------------------------------------------------------------------------
// 実施層: トレーニングセッション
// ----------------------------------------------------------------------------

/// 実際に行った（行う）練習 1 回分。
/// メニューテンプレートから生成するが、生成後はテンプレートから独立する。
model TrainingSession {
  id      String @id @default(cuid())
  ownerId String @default("default-coach")

  title String
  /// 実施日。
  date  DateTime

  /// 由来のテンプレート。表示・追跡のための参照のみで、内容は同期しない。
  sourceMenuTemplateId   String?
  /// 生成時点のテンプレート名（テンプレートが消えても由来が分かるように）。
  sourceMenuNameSnapshot String?

  /// 対象グループ・選手（Phase 1 では自由記述）。
  groupName String?
  location  String?
  weather   String?
  /// 気温など、コンディションの自由記述。
  condition String?

  /// SessionStatus — PLANNED / IN_PROGRESS / COMPLETED / CANCELLED
  status String @default("PLANNED")

  /// 実施後のコーチ所感。
  coachNote String?

  // --- Running Prescription Engine v2 ---
  /// TRAINING | COMPETITION
  sessionKind          String  @default("TRAINING")
  competitionId        String?
  /// 作成時の集計・週次評価・スナップショット検証結果
  planningSnapshotJson String?

  sourceMenuTemplate MenuTemplate? @relation(fields: [sourceMenuTemplateId], references: [id], onDelete: SetNull)
  items              SessionItem[]
  competition        Competition?  @relation(fields: [competitionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, date])
  @@index([ownerId, status])
  @@index([ownerId, sessionKind, date])
}

/// セッション内の 1 項目。
/// planned* はテンプレートからコピーされた計画値、actual* は実施結果。
/// 名前とブロック名もスナップショットするため、後から元データが変わっても不変。
model SessionItem {
  id                String  @id @default(cuid())
  trainingSessionId String
  /// 参照は残すが、記録の正しさはこの参照に依存しない。
  exerciseId        String?

  /// スナップショット: 生成時点の表示名とブロック名。
  exerciseNameSnapshot String
  blockNameSnapshot    String
  sortOrder            Int    @default(0)

  // --- 計画値（テンプレートの MenuItem からコピー）---
  plannedSets             Int?
  plannedReps             Int?
  plannedDistanceMeters   Float?
  plannedDurationSeconds  Int?
  plannedRestSeconds      Int?
  plannedIntensityPercent Int?
  plannedLoadKg           Float?
  plannedNote             String?

  // --- 実績値 ---
  actualSets            Int?
  actualReps            Int?
  actualDistanceMeters  Float?
  actualDurationSeconds Int?
  actualLoadKg          Float?
  /// 実施したか。
  done                  Boolean @default(false)
  /// 実施時のメモ（フォーム、選手の反応など）。
  actualNote            String?

  // --- Running Prescription Engine v2（計画スナップショット・実施ログ）---
  prescriptionKind              String  @default("LEGACY")
  runningMethod                 String?
  sessionTemplateId             String?
  recoveryStructure             String?
  plannedBuildUpDistanceMeters  Float?
  plannedFlyZoneDistanceMeters  Float?
  plannedSetRestSeconds         Int?
  plannedIntraRepRestSeconds    Int?
  plannedIntensityReferenceKind String?
  plannedPrescriptionConfidence String?
  ruleSetVersion                String?
  ruleSetContentHash            String?
  plannedPrescriptionJson       String?
  plannedProvenanceJson         String?
  plannedRationale              String?
  /// 週次文脈用スナップショット（legacy 項目にも入れる）
  loadCategory                  String?
  /// RepLogEntry[]（痛みの部位は含めない）
  actualRepLogJson              String?
  /// QuantityInterval（source 付き）
  actualHighSpeedExposureJson   String?
  stopReason                    String?
  safetyOutcome                 String?
  readinessActionsJson          String?

  trainingSession TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  exercise        Exercise?       @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([trainingSessionId, sortOrder])
  @@index([exerciseId])
  @@index([trainingSessionId, loadCategory])
}

/// 大会カレンダー（日付・優先度）。計画用であり、Running Prescription Engine の第4層ではない。
model Competition {
  id        String            @id @default(cuid())
  ownerId   String            @default("default-coach")
  name      String
  date      DateTime
  endDate   DateTime?
  /// TRAINING_MEET | NORMAL | IMPORTANT | PEAK
  priority  String            @default("NORMAL")
  note      String?
  sessions  TrainingSession[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([ownerId, date])
}

// ----------------------------------------------------------------------------
// AI 拡張ポイント (Phase 2: Qwen 等による動画解析)
//
// Phase 1 では解析そのものは実装しないが、
//   動画 → 解析ジョブ → AI 下書き → コーチ修正 → Exercise 登録
// という導線を後から差し込めるよう、テーブルと状態遷移だけ確定させている。
// 実装の差し替え口は src/domain/ai/ports.ts の VideoAnalyzer。
// ----------------------------------------------------------------------------

/// アップロードされた動画ファイル。Phase 1 では登録・参照のみ。
model VideoAsset {
  id      String @id @default(cuid())
  ownerId String @default("default-coach")

  /// 保存先キー。Phase 1 はローカル public/uploads 配下、
  /// Phase 2 で S3 互換ストレージのキーに差し替え可能。
  storageKey      String
  filename        String
  mimeType        String  @default("video/mp4")
  sizeBytes       Int?
  durationSeconds Int?
  thumbnailKey    String?
  /// 元動画の参照URL（YouTube 等）。
  sourceUrl       String?

  /// 解析結果として紐付いた種目（未解析の間は null）。
  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  analysisJobs AnalysisJob[]
  drafts       ExerciseDraft[]
  guidanceRevisions ExerciseVideoGuidanceRevision[]

  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

/// 動画解析ジョブ 1 件。Phase 2 で VideoAnalyzer 実装が状態を進める。
model AnalysisJob {
  id           String @id @default(cuid())
  videoAssetId String

  /// AnalysisJobStatus — PENDING / RUNNING / SUCCEEDED / FAILED
  status   String  @default("PENDING")
  /// 使用したモデル（例: "qwen2.5-vl-72b"）。実装非依存に保つため文字列。
  provider String?
  model    String?

  /// モデルの生出力（JSON 文字列）。再解析・監査用に必ず残す。
  rawOutput    String?
  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  videoAsset VideoAsset      @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  drafts     ExerciseDraft[]

  @@index([videoAssetId])
  @@index([status])
}

/// AI が生成した「種目の下書き」。コーチが修正して Exercise として確定する。
/// 下書きと確定データを分けることで、AI 出力が直接カタログを汚さない。
model ExerciseDraft {
  id            String  @id @default(cuid())
  ownerId       String  @default("default-coach")
  analysisJobId String?
  videoAssetId  String?

  /// Exercise 相当の候補フィールドを JSON 文字列で保持。
  /// スキーマは src/domain/ai/draft-schema.ts の exerciseDraftPayloadSchema で検証する。
  payload String

  /// 0.0 〜 1.0。モデルが返さない場合は null。
  confidence Float?

  /// DraftStatus — PENDING_REVIEW / APPLIED / REJECTED
  status String @default("PENDING_REVIEW")

  /// 確定して作られた Exercise。
  appliedExerciseId String?
  appliedExercise   Exercise? @relation(fields: [appliedExerciseId], references: [id], onDelete: SetNull)

  analysisJob AnalysisJob? @relation(fields: [analysisJobId], references: [id], onDelete: SetNull)
  videoAsset  VideoAsset?  @relation(fields: [videoAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
}

// ----------------------------------------------------------------------------
// Reusable video knowledge: immutable revisions, one active head, audit history.
// Authority remains AI_ANALYZED / COACH_REVIEWED. Partial knowledge is recorded
// separately in fieldAssessmentJson and never changes Exercise.status/defaults.
// SQLite append-only/boundary triggers live in the additive migration.
// ----------------------------------------------------------------------------

model ExerciseVideoGuidanceRevision {
  id                String @id @default(cuid())
  ownerId           String
  exerciseId        String
  sourceVideoId     String
  sourceBindingJson String
  sourceBindingHash String
  payloadJson       String
  payloadHash       String
  authorityStatus   String
  revisionOrigin    String
  parentRevisionId  String?
  baseAiRevisionId  String?
  fieldAssessmentJson String
  aiMetadataJson    String?
  provenanceJson    String
  analyzedAt        DateTime
  reviewedAt        DateTime?
  reviewerActorId   String?
  reviewReason      String?
  operationKey      String
  operationHash     String
  importSourceHash  String?
  createdAt         DateTime @default(now())

  exercise    Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceVideo VideoAsset @relation(fields: [sourceVideoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parentRevision ExerciseVideoGuidanceRevision? @relation("GuidanceRevisionParent", fields: [parentRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  childRevisions ExerciseVideoGuidanceRevision[] @relation("GuidanceRevisionParent")
  baseAiRevision ExerciseVideoGuidanceRevision? @relation("GuidanceRevisionBaseAi", fields: [baseAiRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  derivedRevisions ExerciseVideoGuidanceRevision[] @relation("GuidanceRevisionBaseAi")
  approvedHeads ExerciseVideoGuidanceHead[] @relation("GuidanceApprovedHead")
  activeAiHeads ExerciseVideoGuidanceHead[] @relation("GuidanceActiveAiHead")
  candidateHeads ExerciseVideoGuidanceHead[] @relation("GuidanceCandidateHead")

  @@unique([ownerId, exerciseId, operationKey])
  @@index([ownerId, exerciseId, createdAt])
  @@index([sourceVideoId])
}

model ExerciseVideoGuidanceHead {
  ownerId                   String
  exerciseId                String
  approvedRevisionId        String?
  activeAiRevisionId        String?
  latestCandidateRevisionId String?
  rowVersion                Int @default(0)
  updatedAt                 DateTime @updatedAt

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedRevision ExerciseVideoGuidanceRevision? @relation("GuidanceApprovedHead", fields: [approvedRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeAiRevision ExerciseVideoGuidanceRevision? @relation("GuidanceActiveAiHead", fields: [activeAiRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  latestCandidateRevision ExerciseVideoGuidanceRevision? @relation("GuidanceCandidateHead", fields: [latestCandidateRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([ownerId, exerciseId])
}

model VideoGuidanceAuditEvent {
  id                  String @id @default(cuid())
  ownerId             String
  exerciseId          String
  actorId             String?
  actorKind           String
  operation           String
  reason              String
  beforeJson          String
  afterJson           String
  expectedRowVersion  Int
  resultingRowVersion Int
  operationKey        String
  timestamp           DateTime @default(now())

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([ownerId, exerciseId, operationKey, operation])
  @@index([ownerId, exerciseId, timestamp])
}

// ----------------------------------------------------------------------------
// Better Auth identity and server-owned video-guidance permissions.
// These are additive tables: existing ownerId values are resource scopes, not
// authentication identities, and never imply a grant to a same-named user.
// ----------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  sessions            Session[]
  accounts            Account[]
  guidanceOwnerAccess GuidanceOwnerAccess[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

/// Explicit grant; permission is one of VIEW_VIDEO_GUIDANCE,
/// REVIEW_VIDEO_GUIDANCE, or PUBLISH_VIDEO_GUIDANCE (checked in SQL).
model GuidanceOwnerAccess {
  userId     String
  ownerId    String
  permission String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, ownerId, permission])
}

// Phase 3: isolated control plane. No relation or write capability to Guidance heads/revisions.
model VideoGuidanceBatch {
  id String @id
  ownerId String
  actorId String
  creationKey String
  manifestHash String
  configJson String
  status String @default("PENDING")
  requestedAt DateTime
  startedAt DateTime?
  endedAt DateTime?
  heartbeat DateTime?
  stopReason String?
  requestBudget Int
  tokenBudget Int
  costBudget Int
  reservedRequests Int @default(0)
  reservedTokens Int @default(0)
  reservedCost Int @default(0)
  usedRequests Int @default(0)
  usedTokens Int @default(0)
  usedCost Int @default(0)
  rowVersion Int @default(0)
  @@unique([ownerId, creationKey])
}

model VideoGuidanceBatchItem {
  id String @id
  batchId String
  ownerId String
  exerciseId String
  sourceBindingJson String
  contentKey String
  workKey String
  workId String
  configHash String
  status String @default("PENDING")
  resultQuality String?
  observationId String?
  resultRevisionId String?
  skipReason String?
  errorCode String?
  retryCount Int @default(0)
  retryAt DateTime?
  leaseOwner String?
  leaseExpiresAt DateTime?
  fencingToken Int @default(0)
  rowVersion Int @default(0)
  @@unique([batchId, workKey])
  @@index([workId])
}

model VideoAnalysisWork {
  id String @id
  ownerId String
  contentKey String
  status String @default("READY")
  leaseOwner String?
  leaseExpiresAt DateTime?
  fencingToken Int @default(0)
  activeItemId String?
  observationId String?
  attemptCount Int @default(0)
  retryCount Int @default(0)
  retryAt DateTime?
  errorCode String?
  @@unique([ownerId, contentKey])
}

model VideoAnalysisAttempt {
  id String @id
  workId String
  itemId String
  batchId String
  ownerId String
  attemptNo Int
  dispatchKey String @unique
  fencingToken Int
  reservedAt DateTime
  dispatchStartedAt DateTime?
  providerRequestId String?
  responseReceivedAt DateTime?
  rawJson String?
  rawHash String?
  // Real provider bytes stay LOCAL_PRIVATE. rawJson remains synthetic-only.
  rawRef String?
  responseMetadataJson String?
  providerUsageJson String?
  candidateJson String?
  outcome String @default("RESERVED")
  latencyMs Int?
  errorCode String?
  retryable Boolean @default(false)
  usageJson String?
  reconciliationState String @default("NONE")
  reconciledBy String?
  reconciledAt DateTime?
  reconciliationEvidenceJson String?
  reservationRequests Int
  reservationTokens Int
  reservationCost Int
  accounted Boolean @default(false)
  @@unique([workId, attemptNo])
  @@index([itemId])
}

// One approved input, one count request. This is not a model inference Attempt.
model VideoLunaPreflight {
  id String @id
  ownerId String
  actorId String
  runId String @default("")
  previousPreflightId String? @unique
  payloadHash String
  frameManifestHash String
  manifestHash String
  manifestJson String
  requestedAt DateTime
  expiresAt DateTime
  countOutcome String @default("PENDING")
  countDispatchKey String @unique
  countSentAt DateTime?
  countRequestId String?
  countRawRef String?
  countRawHash String?
  countReceiptJson String?
  countError String?
  responseApprovalJson String?
  responseBatchId String? @unique
  @@unique([ownerId, runId])
  @@index([ownerId, payloadHash])
}

model VideoObservationResult {
  id String @id
  ownerId String
  contentKey String
  attemptId String @unique
  rawHash String
  payloadJson String
  quality String
  createdAt DateTime
  @@unique([ownerId, contentKey])
}
